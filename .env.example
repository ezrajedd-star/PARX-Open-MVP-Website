# Copy to .env.local for local development, and set the same keys in Vercel → Project → Settings → Environment Variables.

# Public site URL (used for canonical URLs, sitemap and Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://parx-open.vercel.app

# Sponsorship inquiry form endpoint (e.g. https://formspree.io/f/xxxxxxx).
# Leave empty to fall back to a mailto: link using the contact email in content/site.json.
NEXT_PUBLIC_FORM_ENDPOINT=
# Optional: separate endpoints per form (fall back to NEXT_PUBLIC_FORM_ENDPOINT).
NEXT_PUBLIC_SPONSOR_FORM_ENDPOINT=
NEXT_PUBLIC_DRIVER_FORM_ENDPOINT=
NEXT_PUBLIC_HOST_FORM_ENDPOINT=

# Meta (Facebook) Pixel ID. Leave empty to disable the pixel completely.
NEXT_PUBLIC_META_PIXEL_ID=
